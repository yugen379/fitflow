{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    // Turned on after installing @types/react revealed the project had been
    // compiling React as `any`. It immediately caught three real bugs
    // (an overwritten dock handler, two loose promise/array types) and the tree
    // is clean under it — so it stays on to keep catching them.
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // "android" and "ios" hold a COPY of dist (the native web-asset bundle), so
  // globbing them makes tsc walk the built output twice over — enough to blow
  // the default heap once the iOS project exists. They are build output, not
  // source, and belong here next to "dist".
  "exclude": ["functions", "node_modules", "dist", "android", "ios"]
}
